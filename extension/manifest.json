{
  "manifest_version": 3,
  "name": "FSB v0.9.91",
  "version": "0.9.91",
  "minimum_chrome_version": "116",
  "description": "FSB - Universal AI-powered browser automation assistant with multi-model support",
  "homepage_url": "https://full-selfbrowsing.com",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "unlimitedStorage",
    "tabs",
    "windows",
    "sidePanel",
    "debugger",
    "webNavigation",
    "alarms",
    "notifications",
    "clipboardWrite",
    "offscreen",
    "nativeMessaging",
    "system.memory"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "assets/icon16.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "ui/sidepanel.html"
  },
  "commands": {
    "toggle-skopeo-current-tab": {
      "suggested_key": {
        "default": "Ctrl+Shift+Space",
        "mac": "Alt+Space"
      },
      "description": "Toggle Skopeo in current tab"
    }
  },
  "options_page": "ui/control_panel.html",
  "web_accessible_resources": [
    {
      "resources": [
        "assets/icon48.png",
        "site-maps/*.json",
        "test-data/**/*",
        "utils/redactForLog.js",
        "utils/diagnostics-ring-buffer.js",
        "offscreen/lattice-host.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "canvas-interceptor.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
