# FSB Server Configuration
FSB_SERVER_SECRET=change-this-to-a-random-secret-string
PORT=3847

# Server-only fine-grained GitHub token used by the public Stats cache poller.
# Restrict it to fullselfbrowsing/FSB with Metadata read and Contents read.
GITHUB_TOKEN=

# Hosted Jev decision gateway (/api/jev). Off by default: it answers
# "disabled" unless JEV_ENABLED is true or 1 and the route below is valid.
# Route and model pin are configuration only, with no default route. Use one of:
#   TypeSafe direct: JEV_UPSTREAM_URL=https://api.typesafe.ai/v1/systemone
#                    JEV_MODEL=jev-1.13.0 (a full x.y.z version, never an alias)
#   OpenRouter:      JEV_UPSTREAM_URL=https://openrouter.ai/api/v1/systemone
#                    JEV_MODEL=typesafe/jev-1.13 (optionally dated, never an alias)
# JEV_API_KEY is a server-only secret. Set it locally here (this file's copy,
# .env, is gitignored) and in production with `fly secrets set`, never in
# fly.toml [env]. Invalid values make the gateway answer "not_configured".
JEV_ENABLED=false
JEV_UPSTREAM_URL=
JEV_MODEL=
JEV_API_KEY=
JEV_INPUT_USD_PER_MTOK=0.042
JEV_MAX_CONCURRENCY=16
JEV_UPSTREAM_TIMEOUT_MS=1500
JEV_DAILY_USD_CAP=2
